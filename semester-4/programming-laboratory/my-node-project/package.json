{
  "name": "restaurant-management-monorepo",
  "version": "1.0.0",
  "description": "Gestor de cardápio digital e pedidos para restaurantes",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "backend:dev": "npm --prefix backend run dev",
    "backend:migrate": "npm --prefix backend run prisma:migrate",
    "backend:seed": "npm --prefix backend run prisma:seed",
    "backend:seed:demo": "npm --prefix backend run prisma:seed:demo",
    "backend:studio": "npm --prefix backend run prisma:studio",
    "backend:test": "npm --prefix backend run test",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "keywords": ["restaurant", "management", "express", "prisma", "postgres", "kds"],
  "author": "",
  "license": "ISC"
}
